{
  "expo": {
    "name": "Profit Pocket",
    "slug": "profit-pocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "profitpocket",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D101B",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "au.profitpocket.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "CFBundleDisplayName": "Profit Pocket",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["C617.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime", "NSPrivacyAccessedAPITypeReasons": ["35F9.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace", "NSPrivacyAccessedAPITypeReasons": ["E174.1"] }
        ]
      }
    },
    "android": {
      "package": "au.profitpocket.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0D101B" }
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 150, "resizeMode": "contain", "backgroundColor": "#0D101B" }],
      "expo-iap",
      "expo-font",
      "expo-localization",
      ["expo-image-picker", { "photosPermission": "Profit Pocket uses your photos so you can add a logo to your projects.", "cameraPermission": false, "microphonePermission": false }]
    ]
  }
}
